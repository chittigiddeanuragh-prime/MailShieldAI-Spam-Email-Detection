 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 🛡️ MailShield AI — Model Experimentation & Evaluation Notebook\n",
    "This notebook demonstrates exploratory data analysis (EDA), TF-IDF feature extraction, model comparison across multiple Scikit-learn algorithms (Logistic Regression, SVM, Random Forest, Naive Bayes), and comprehensive metric evaluation (Precision, Recall, F1-Score, Confusion Matrix)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import sys\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.svm import SVC\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.naive_bayes import ComplementNB\n",
    "from sklearn.metrics import classification_report, confusion_matrix, precision_score, recall_score, f1_score\n",
    "\n",
    "# Import custom utils\n",
    "from src.utils.text_cleaner import preprocess_email_text\n",
    "from src.pipeline.train_pipeline import SAMPLE_DATASET"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Data Preparation & Preprocessing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df = pd.DataFrame(SAMPLE_DATASET, columns=[\"text\", \"label\"])\n",
    "df['cleaned_text'] = df['text'].apply(preprocess_email_text)\n",
    "print(f\"Total Samples: {len(df)}\")
    "print(df['label'].value_counts())\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Feature Vectorization (TF-IDF)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "vectorizer = TfidfVectorizer(ngram_range=(1, 2), max_features=5000, sublinear_tf=True)\n",
    "X = vectorizer.fit_transform(df['cleaned_text'])\n",
    "y = df['label']\n",
    "print(f\"Vectorized Matrix Shape: {X.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Model Training & Comparison"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "models = {\n",
    "    \"Logistic Regression\": LogisticRegression(C=1.0),\n",
    "    \"Support Vector Machine (Linear)\": SVC(kernel='linear'),\n",
    "    \"Random Forest Classifier\": RandomForestClassifier(n_estimators=50, random_state=42),\n",
    "    \"Complement Naive Bayes\": ComplementNB()\n",
    "}\n",
    "\n",
    "results = []\n",
    "for name, clf in models.items():\n",
    "    clf.fit(X, y)\n",
    "    preds = clf.predict(X)\n",
    "    p = precision_score(y, preds)\n",
    "    r = recall_score(y, preds)\n",
    "    f1 = f1_score(y, preds)\n",
    "    results.append({\n",
    "        \"Model\": name,\n",
    "        \"Precision\": round(p, 4),\n",
    "        \"Recall\": round(r, 4),\n",
    "        \"F1-Score\": round(f1, 4)\n",
    "    })\n",
    "\n",
    "metrics_df = pd.DataFrame(results)\n",
    "metrics_df"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Confusion Matrix Evaluation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "best_clf = models[\"Logistic Regression\"]\n",
    "best_clf.fit(X, y)\n",
    "preds = best_clf.predict(X)\n",
    "cm = confusion_matrix(y, preds)\n",
    "print(\"Confusion Matrix:\")\n",
    "print(cm)\n",
    "print(\"\\nClassification Report:\")\n",
    "print(classification_report(y, preds, target_names=[\"Ham\", \"Spam\"]))"
   ]
  }
 ],
